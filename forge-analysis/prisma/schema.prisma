// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A project is an uploaded ZIP that has been extracted.
model Project {
  id            String   @id @default(cuid())
  name          String
  fileName      String
  extractedPath String
  fileSize      Int
  fileCount     Int
  kind          String
  detection     String
  createdAt     DateTime @default(now())

  // Repository linkage (optional). When repoUrl is set, the project's
  // extractedPath is treated as a git working tree and the repo APIs
  // (pull / branches / log / status / checkout) become available.
  repoUrl       String?
  repoBranch    String?
  repoProvider  String?  // "github" | "gitlab" | "bitbucket" | "other"
  repoDepth     Int      @default(0)  // clone depth used (0 = full)
  lastPulledAt  DateTime?
  lastFetchAt   DateTime?

  runs          Run[]
  secrets       Secret[]
  envVars       EnvVar[]
  caches        CacheEntry[]
  triggers      Trigger[]
  notifications Notification[]
  pipelines     Pipeline[]
  settings      ProjectSettings?
  environments  Environment[]
  apiTokens     ApiToken[]
  scheduledRuns ScheduledRun[]
}

// A single execution of a workflow on a project.
model Run {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflow    String
  status      String    @default("queued")
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  exitCode    Int?
  durationMs  Int?
  trigger     String    @default("manual")
  logs        LogLine[]
  artifacts   Artifact[]
  testReports TestReport[]

  // --- Extensions ---
  // For matrix sub-runs: the parent run.
  parentRunId    String?
  // For matrix: JSON of the matrix values applied (e.g. {"node_version":"18"}).
  matrixValues   String?
  // For pipeline stages: which stage this run belongs to.
  pipelineRunId  String?
  pipelineRun    PipelineRun? @relation("PipelineRunRuns", fields: [pipelineRunId], references: [id], onDelete: SetNull)
  stageId        String?
  // For re-runs: which run this re-runs.
  reRunOfId      String?
  // Retry count (how many times this step was retried).
  retryCount     Int       @default(0)
  // Timeout in ms (null = no timeout).
  timeoutMs      Int?
  // Whether approval was required and obtained before running.
  requiresApproval Boolean @default(false)
  // Human-readable label for the run (e.g. "build (node 18)").
  label          String?
  // Index of this run within a matrix fan-out (0, 1, 2, ...).
  matrixIndex    Int?
  // Total number of runs in the matrix (if this is a parent).
  matrixTotal    Int?
  // Concurrency group: runs in the same group are serialized.
  concurrencyGroup String?
  // Job summary (markdown), like $GITHUB_STEP_SUMMARY.
  summary        RunSummary?
  // Annotations (errors, warnings, notices).
  annotations    Annotation[]

  @@index([projectId, status])
  @@index([concurrencyGroup])
}

model LogLine {
  id     String   @id @default(cuid())
  runId  String
  run    Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq    Int
  stream String
  text   String
  ts     DateTime @default(now())

  @@index([runId, seq])
  @@index([text])
}

model Artifact {
  id        String   @id @default(cuid())
  runId     String
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  name      String
  path      String
  size      Int
  mime      String
  createdAt DateTime @default(now())
}

// ============================================================
// Phase 2: Secrets, Env Vars, Cache
// ============================================================

model Secret {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key       String
  // AES-256-GCM encrypted value (base64).
  ciphertext String
  iv         String
  tag        String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([projectId, key])
}

model EnvVar {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key       String
  value     String
  createdAt DateTime @default(now())

  @@unique([projectId, key])
}

model CacheEntry {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key        String
  label      String
  path       String
  size       Int
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  hitCount   Int      @default(0)

  @@unique([projectId, key])
  @@index([projectId, lastUsedAt])
}

// ============================================================
// Phase 3: Triggers & Notifications
// ============================================================

model Trigger {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String   // 'webhook' | 'cron'
  config      String   // webhook: slug; cron: cron expression
  workflow    String
  pipelineId  String?  // optional: trigger a pipeline instead of a single workflow
  enabled     Boolean  @default(true)
  secret      String?  // webhook HMAC secret
  createdAt   DateTime @default(now())
  lastFiredAt DateTime?
  deliveries  WebhookDelivery[]
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  triggerId  String
  trigger    Trigger  @relation(fields: [triggerId], references: [id], onDelete: Cascade)
  method     String
  headers    String
  body       String
  runId      String?
  status     String   // 'accepted' | 'rejected' | 'error'
  error      String?
  receivedAt DateTime @default(now())

  @@index([triggerId, receivedAt])
}

model Notification {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  event     String   // 'started' | 'success' | 'failure' | 'always'
  url       String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ============================================================
// Phase 4: Pipelines (multi-stage DAG)
// ============================================================

model Pipeline {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  // JSON: [{id, name, workflow, needs:[stageId], matrix:[{key,values}], retry, timeoutMs, requiresApproval, secrets:[key], cache:{key, paths:[]}}]
  stages    String
  // JSON: {concurrentCancellation, defaultRetry, defaultTimeoutMs, notifications}
  config    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs      PipelineRun[]
}

model PipelineRun {
  id          String   @id @default(cuid())
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  projectId   String
  status      String   @default("running")
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  trigger     String   @default("manual")
  context     String   @default("{}")
  stageRuns   StageRun[]
  runs        Run[]    @relation("PipelineRunRuns")
}

model StageRun {
  id            String   @id @default(cuid())
  pipelineRunId String
  pipelineRun   PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)
  stageId       String
  stageName     String
  status        String   @default("pending")
  startedAt     DateTime?
  finishedAt    DateTime?
  matrixValues  String?  // JSON
  runIds        String   @default("[]")
  error         String?
}

// ============================================================
// Phase 5: Test Reports & Approvals
// ============================================================

model TestReport {
  id        String   @id @default(cuid())
  runId     String
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  format    String   // 'junit' | 'json' | 'tap'
  total     Int
  passed    Int
  failed    Int
  skipped   Int
  duration  Int?
  suites    String   // JSON: full suite tree
  createdAt DateTime @default(now())

  @@index([runId])
}

model Approval {
  id          String   @id @default(cuid())
  runId       String   @unique
  status      String   @default("pending")
  requestedAt DateTime @default(now())
  decidedAt   DateTime?
  decidedBy   String?
  reason      String?
  expiresAt   DateTime?
}

// ============================================================
// Phase 6: Project settings
// ============================================================

model ProjectSettings {
  id                    String  @id @default(cuid())
  projectId             String  @unique
  project               Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  concurrentCancellation Boolean @default(true)
  defaultRetry          Int     @default(0)
  defaultTimeoutMs      Int?
  maxConcurrentRuns     Int     @default(1)
  autoSaveCache         Boolean @default(true)
  retentionDays         Int     @default(90)
  // Concurrency group: if set, runs on this project are serialized.
  concurrencyGroup      String?
  // Whether to cancel in-progress runs when a new run starts in the same group.
  cancelInProgress      Boolean @default(false)
}

// ============================================================
// Phase 7: Deployment environments (staging/prod with approvals)
// ============================================================

model Environment {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String   // e.g. "staging", "production"
  description String?
  requiresApproval Boolean @default(false)
  requiredReviewers Int   @default(0)  // number of approvals needed
  url         String?  // deployment URL (e.g. https://app.example.com)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deployments Deployment[]

  @@unique([projectId, name])
  @@index([projectId])
}

model Deployment {
  id            String   @id @default(cuid())
  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  runId         String?  // the run that produced this deployment
  status        String   @default("pending")  // pending, in_progress, success, failed, canceled
  version       String?  // version label (e.g. "v1.2.3" or commit sha)
  deployedAt    DateTime?
  deployedBy    String?
  rollbackOfId  String?  // if this is a rollback, points to the previous deployment
  createdAt     DateTime @default(now())

  @@index([environmentId])
  @@index([runId])
}

// ============================================================
// Phase 8: Job summaries + concurrency groups
// ============================================================

model RunSummary {
  id        String   @id @default(cuid())
  runId     String   @unique
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  content   String   // markdown content
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// Phase 9: API tokens (external access) + scheduled runs
// ============================================================

model ApiToken {
  id          String   @id @default(cuid())
  name        String
  tokenHash   String   @unique  // SHA-256 hash of the token
  prefix      String             // first 8 chars for display (e.g. "fk_abc123…")
  projectId   String?            // null = all projects
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scopes      String   @default("read")  // comma-separated: read,run,write,admin
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  @@index([projectId])
  @@index([tokenHash])
}

model ScheduledRun {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflow    String
  cron        String              // cron expression (e.g. "0 9 * * 1-5" = weekdays 9am)
  timezone    String   @default("UTC")
  enabled     Boolean  @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  runCount    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([nextRunAt])
}

// ============================================================
// Phase 10: Run annotations + code metrics
// ============================================================

model Annotation {
  id          String   @id @default(cuid())
  runId       String
  run         Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  level       String   // "error", "warning", "notice"
  message     String
  file        String?
  line        Int?
  column      Int?
  createdAt   DateTime @default(now())

  @@index([runId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String   // "run.started", "project.created", "secret.set", etc.
  entityId  String?
  entityType String?  // "project", "run", "secret", "trigger"
  actor     String?   // who performed the action
  details   String?   // JSON string with additional context
  ip        String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================================
// Phase 11: Experiments Lab — sandboxed breakthrough discovery
// ============================================================
// The Experiments Lab runs hard, monitored experiments on Forge
// itself to discover development breakthroughs. Each experiment
// has a hypothesis, a sandboxed procedure, captured metrics, and
// a verdict (BREAKTHROUGH / NO_CHANGE / REGRESSION). Breakthroughs
// can be promoted to permanent Forge workflows.
// ============================================================

model Experiment {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String   // "self-improvement" | "tournament" | "synthesis" | "adversarial" | "recursive"
  hypothesis  String
  procedure   String   // human-readable description of the steps
  dangerLevel String   @default("safe") // "safe" | "moderate" | "aggressive"
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  runs        ExperimentRun[]

  @@index([category])
}

model ExperimentRun {
  id            String   @id @default(cuid())
  experimentId  String
  experiment    Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  status        String   // "running" | "completed" | "failed" | "timeout" | "killed"
  verdict       String?  // "BREAKTHROUGH" | "NO_CHANGE" | "REGRESSION"
  verdictReason String?
  metrics       String?  // JSON: { durationMs, scriptsGenerated, scriptsRun, stdoutBytes, ... }
  evidence      String?  // JSON: { steps: [{name, input, output, durationMs, ok}], summary }
  promoted      Boolean  @default(false)
  promotedWorkflowId String?
  promotedPresetId String?
  startedAt     DateTime @default(now())
  completedAt   DateTime?

  @@index([experimentId])
  @@index([status])
  @@index([startedAt])
  @@index([verdict])
}
