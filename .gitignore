# =============================================================================
# Forge — .gitignore
# =============================================================================

# Dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
/build

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Misc
.DS_Store
*.pem

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
dev.log
dev.out.log
server.log

# Environment variables (never commit)
.env*
!.env.example

# Local config / IDE
local-*
.claude
.z-ai-config

# Process files
*.pid

# =============================================================================
# Forge-specific (runtime data, secrets, internal artifacts)
# =============================================================================

# Skills directory (private tooling)
/skills/

# Encrypted GitHub token store
.forge-settings.json

# Uploaded files (may contain secrets)
upload/

# Storage (project data, extracted sources, artifacts)
storage/

# Database files (SQLite)
db/

# Tool results (agent read logs)
tool-results/

# Agent worklog (internal build history)
worklog.md

# Download artifacts (generated output)
download/

# Stale duplicate snapshot (kept locally, never tracked)
forge-analysis/

# Prompt files
prompt
test
