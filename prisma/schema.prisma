// ============================================================
// Forge — Prisma schema (reconstructed)
// ============================================================
// One coherent data model for the whole Forge product.
// All owned-by-Run and owned-by-Project relations use onDelete: Cascade
// so we no longer need a manual cascade in application code.
// ScheduledRun has been removed — cron scheduling lives in Trigger
// with type='cron', so there is a single cron subsystem.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A project is an uploaded ZIP that has been extracted, or a cloned
// git repository. The extractedPath is treated as the working tree.
model Project {
  id            String   @id @default(cuid())
  name          String
  fileName      String
  extractedPath String
  fileSize      Int
  fileCount     Int
  kind          String // "node" | "python" | "rust" | "go" | "unknown"
  detection     String // JSON of the DetectionResult
  createdAt     DateTime @default(now())

  // Repository linkage (optional). When repoUrl is set, the project's
  // extractedPath is treated as a git working tree and the repo APIs
  // (pull / branches / log / status / checkout) become available.
  repoUrl       String?
  repoBranch    String?
  repoProvider  String? // "github" | "gitlab" | "bitbucket" | "other"
  repoDepth     Int     @default(0) // clone depth used (0 = full)
  lastPulledAt  DateTime?
  lastFetchAt   DateTime?

  runs          Run[]
  secrets       Secret[]
  envVars       EnvVar[]
  caches        CacheEntry[]
  triggers      Trigger[]
  notifications Notification[]
  pipelines     Pipeline[]
  settings      ProjectSettings?
  environments  Environment[]
  apiTokens     ApiToken[]

  @@index([createdAt])
}

// A single execution of a workflow on a project.
model Run {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflow    String
  status      String    @default("queued") // queued|running|success|failed|canceled|waiting_approval
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  exitCode    Int?
  durationMs  Int?
  trigger     String    @default("manual") // manual|auto|webhook|cron|pipeline
  headSha     String?
  checkRunId  Int?

  logs        LogLine[]
  artifacts   Artifact[]
  testReports TestReport[]
  annotations Annotation[]
  summary     RunSummary?
  approval    Approval?

  // --- Matrix / pipeline / rerun metadata ---
  parentRunId      String?   // matrix parent run
  matrixValues     String?   // JSON of matrix values applied (e.g. {"node":"18"})
  matrixIndex      Int?      // 0,1,2,... within a matrix fan-out
  matrixTotal      Int?      // total runs in the matrix (if this is a parent)
  pipelineRunId    String?
  pipelineRun      PipelineRun? @relation("PipelineRunRuns", fields: [pipelineRunId], references: [id], onDelete: SetNull)
  stageId          String?
  reRunOfId        String?
  retryCount       Int       @default(0)
  timeoutMs        Int?
  requiresApproval Boolean   @default(false)
  label            String?
  concurrencyGroup String?

  @@index([projectId, status])
  @@index([concurrencyGroup])
  @@index([startedAt])
}

model LogLine {
  id     String   @id @default(cuid())
  runId  String
  run    Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq    Int
  stream String // "stdout" | "stderr" | "system"
  text   String
  ts     DateTime @default(now())

  @@index([runId, seq])
  @@index([text])
}

model Artifact {
  id        String   @id @default(cuid())
  runId     String
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  name      String
  path      String
  size      Int
  mime      String
  createdAt DateTime @default(now())

  @@index([runId])
}

// ============================================================
// Secrets, Env Vars, Cache
// ============================================================

model Secret {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key        String
  ciphertext String   // AES-256-GCM, base64
  iv         String
  tag        String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([projectId, key])
}

model EnvVar {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key       String
  value     String
  createdAt DateTime @default(now())

  @@unique([projectId, key])
}

model CacheEntry {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key        String
  label      String
  path       String
  size       Int
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  hitCount   Int      @default(0)

  @@unique([projectId, key])
  @@index([projectId, lastUsedAt])
}

// ============================================================
// Triggers (webhook + cron) & Notifications
// ============================================================
// Trigger is the SINGLE source of truth for both webhook and cron
// triggers. The deprecated ScheduledRun model has been removed.

model Trigger {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String   // "webhook" | "cron"
  config      String   // webhook: slug; cron: cron expression
  workflow    String
  pipelineId  String?  // optional: trigger a pipeline instead of a single workflow
  enabled     Boolean  @default(true)
  secret      String?  // webhook HMAC secret
  timezone    String?  // optional timezone for cron triggers
  createdAt   DateTime @default(now())
  lastFiredAt DateTime?
  deliveries  WebhookDelivery[]

  @@index([projectId])
  @@index([type, enabled])
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  triggerId  String
  trigger    Trigger  @relation(fields: [triggerId], references: [id], onDelete: Cascade)
  method     String
  headers    String
  body       String
  runId      String?
  status     String   // "accepted" | "rejected" | "error"
  error      String?
  receivedAt DateTime @default(now())

  @@index([triggerId, receivedAt])
}

model Notification {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  event     String   // "started" | "success" | "failure" | "always"
  url       String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ============================================================
// Pipelines (multi-stage DAG)
// ============================================================

model Pipeline {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  stages    String   // JSON: [{id,name,workflow,needs,matrix,retry,timeoutMs,requiresApproval,secrets,cache}]
  config    String   // JSON: {concurrentCancellation,defaultRetry,defaultTimeoutMs,notifications}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs      PipelineRun[]

  @@index([projectId])
}

model PipelineRun {
  id          String   @id @default(cuid())
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  projectId   String
  status      String   @default("running")
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  trigger     String   @default("manual")
  context     String   @default("{}")
  stageRuns   StageRun[]
  runs        Run[]    @relation("PipelineRunRuns")

  @@index([pipelineId])
  @@index([projectId, status])
}

model StageRun {
  id            String   @id @default(cuid())
  pipelineRunId String
  pipelineRun   PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)
  stageId       String
  stageName     String
  status        String   @default("pending")
  startedAt     DateTime?
  finishedAt    DateTime?
  matrixValues  String?  // JSON
  runIds        String   @default("[]")
  error         String?

  @@index([pipelineRunId])
}

// ============================================================
// Test Reports, Approvals, Summaries, Annotations
// ============================================================

model TestReport {
  id        String   @id @default(cuid())
  runId     String
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  format    String   // "junit" | "json" | "tap"
  total     Int
  passed    Int
  failed    Int
  skipped   Int
  duration  Int?
  suites    String   // JSON: full suite tree
  createdAt DateTime @default(now())

  @@index([runId])
}

model Approval {
  id          String   @id @default(cuid())
  runId       String   @unique
  run         Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  status      String   @default("pending") // pending|approved|rejected|expired
  requestedAt DateTime @default(now())
  decidedAt   DateTime?
  decidedBy   String?
  reason      String?
  expiresAt   DateTime?
}

model RunSummary {
  id        String   @id @default(cuid())
  runId     String   @unique
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  content   String   // markdown
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Annotation {
  id        String   @id @default(cuid())
  runId     String
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  level     String   // "error" | "warning" | "notice"
  message   String
  file      String?
  line      Int?
  column    Int?
  createdAt DateTime @default(now())

  @@index([runId])
}

// ============================================================
// Project settings + Deployment environments
// ============================================================

model ProjectSettings {
  id                     String  @id @default(cuid())
  projectId              String  @unique
  project                Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  concurrentCancellation Boolean @default(true)
  defaultRetry           Int     @default(0)
  defaultTimeoutMs       Int?
  maxConcurrentRuns      Int     @default(1)
  autoSaveCache          Boolean @default(true)
  retentionDays          Int     @default(90)
  concurrencyGroup       String?
  cancelInProgress       Boolean @default(false)
}

model Environment {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name              String   // e.g. "staging", "production"
  description       String?
  requiresApproval  Boolean  @default(false)
  requiredReviewers Int      @default(0)
  url               String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deployments       Deployment[]

  @@unique([projectId, name])
  @@index([projectId])
}

model Deployment {
  id            String   @id @default(cuid())
  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  runId         String?
  status        String   @default("pending") // pending|in_progress|success|failed|canceled
  version       String?
  deployedAt    DateTime?
  deployedBy    String?
  rollbackOfId  String?
  createdAt     DateTime @default(now())

  @@index([environmentId])
  @@index([runId])
}

// ============================================================
// API tokens (external access) + Audit log
// ============================================================

model ApiToken {
  id          String   @id @default(cuid())
  name        String
  tokenHash   String   @unique // SHA-256
  prefix      String            // first 8 chars for display
  projectId   String?           // null = all projects
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scopes      String   @default("read") // comma-separated: read,run,write,admin
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  @@index([projectId])
  @@index([tokenHash])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String   // "run.started", "project.created", "secret.set", etc.
  entityId   String?
  entityType String?  // "project", "run", "secret", "trigger"
  actor      String?
  details    String?  // JSON
  ip         String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================================
// Experiments Lab — sandboxed experiment runner
// ============================================================
// The Experiments Lab runs hard, monitored experiments on Forge
// itself to discover development breakthroughs. Each experiment
// has a hypothesis, a sandboxed procedure, captured metrics, and
// a verdict (BREAKTHROUGH / NO_CHANGE / REGRESSION). Breakthroughs
// can be promoted to permanent Forge workflows.
// ============================================================

model Experiment {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String   // "self-improvement"|"tournament"|"synthesis"|"adversarial"|"recursive"|"product"
  hypothesis  String
  procedure   String
  dangerLevel String   @default("safe") // safe|moderate|aggressive
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  runs        ExperimentRun[]

  @@index([category])
}

model ExperimentRun {
  id                 String   @id @default(cuid())
  experimentId       String
  experiment         Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  status             String   // running|completed|failed|timeout|killed
  verdict            String?  // BREAKTHROUGH|NO_CHANGE|REGRESSION
  verdictReason      String?
  metrics            String?  // JSON
  evidence           String?  // JSON
  promoted           Boolean  @default(false)
  promotedWorkflowId String?
  promotedPresetId   String?
  startedAt          DateTime @default(now())
  completedAt        DateTime?

  @@index([experimentId])
  @@index([status])
  @@index([startedAt])
  @@index([verdict])
}

